# Application
APP_NAME=Zoey Commerce AI
APP_VERSION=0.1.0
ENVIRONMENT=development

# OpenAI
OPENAI_API_KEY= ""

# LangSmith
LANGSMITH_API_KEY=""
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ZoeyCommerceAI

# Meta / WhatsApp
META_VERIFY_TOKEN=replace_with_local_verify_token
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2